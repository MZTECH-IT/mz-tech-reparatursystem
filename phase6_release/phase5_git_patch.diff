+foreach ($loggedCalls as $c) { if (str_contains((string)$c[3], $secret)) $logContainsSecret = true; }
+if ($res['status'] === 200 && count($loggedCalls) === 1 && $loggedCalls[0][0] === 'cron_secret_via_get' && !$logContainsSecret) {
