+        return ['success' => false, 'raw' => null, 'filename' => null, 'message' => 'SOAP-Methodenaufruf ist lieferantenspezifisch zu konfigurieren (siehe SCHNITTSTELLEN_ADAPTER_DOKUMENTATION.txt).'];
