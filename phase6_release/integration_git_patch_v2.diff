+            return ['success' => false, 'message' => 'SFTP-Erweiterung (ssh2) erkannt, Verbindungslogik muss lieferantenspezifisch ergänzt werden (siehe SCHNITTSTELLEN_ADAPTER_DOKUMENTATION.txt).'];
